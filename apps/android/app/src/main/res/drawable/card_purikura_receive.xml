<?xml version="1.0" encoding="utf-8"?>
<!-- Purikura receive card: translucent white with a dashed pink stroke inside. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/purikura_card" />
            <stroke android:width="3dp" android:color="@color/white" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <stroke
                android:width="2dp"
                android:color="@color/purikura_primary"
                android:dashWidth="8dp"
                android:dashGap="5dp" />
        </shape>
    </item>
</layer-list>
