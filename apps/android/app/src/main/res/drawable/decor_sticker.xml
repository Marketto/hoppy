<?xml version="1.0" encoding="utf-8"?>
<!-- Purikura "ぴょん！" sticker: yellow with white die-cut edge and pink ring. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/purikura_primary" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/purikura_yellow" />
            <stroke android:width="3dp" android:color="@color/white" />
        </shape>
    </item>
</layer-list>
