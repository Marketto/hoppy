<?xml version="1.0" encoding="utf-8"?>
<!-- Purikura card: translucent white, 3dp white border, 2dp pink ring outside. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke android:width="2dp" android:color="@color/purikura_ring" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/purikura_card" />
            <stroke android:width="3dp" android:color="@color/white" />
        </shape>
    </item>
</layer-list>
