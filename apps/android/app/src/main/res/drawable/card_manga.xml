<?xml version="1.0" encoding="utf-8"?>
<!-- Manga panel: white, 3dp ink border, hard 4dp ink offset shadow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/manga_ink" />
        </shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/manga_bg" />
            <stroke android:width="3dp" android:color="@color/manga_ink" />
        </shape>
    </item>
</layer-list>
