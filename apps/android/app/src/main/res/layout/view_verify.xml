<?xml version="1.0" encoding="utf-8"?>
<!--
  Verification code of an encrypted session (docs/protocol.md §7.6): 4 large emoji (names
  for TalkBack and as a caption), the only verification method; "They match" / "Later".
  Bound by ui/VerifyPanel.kt; used by SendActivity (sender) and VerifyActivity (receiver).
  Emoji use the system emoji font (all are Unicode ≤ 9).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    android:background="?attr/hoppyCardBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/verifyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/verifyEmoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:letterSpacing="0.15"
        android:textColor="?attr/colorOnSurface"
        android:textSize="44sp" />

    <TextView
        android:id="@+id/verifyWords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/verifyWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/verify_name_warning"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/verifyDone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/verifyActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <app.hoppy.ui.theme.HoppyButton
            android:id="@+id/verifyMatch"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="@string/verify_match" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/verifyLater"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/verify_later"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
