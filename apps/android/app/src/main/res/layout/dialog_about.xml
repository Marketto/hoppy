<?xml version="1.0" encoding="utf-8"?>
<!-- "About" dialog (MainActivity.showAbout): mascot, name, version, author, GitHub link,
     "Check for updates", open-source licences. Every text is ?attr/colorOnSurface on the
     dialog surface, the pair already used by all dialogs (contrast-checked). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:importantForAccessibility="no"
            android:src="?attr/hoppyMascot" />

        <TextView
            android:id="@+id/aboutName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityHeading="true"
            android:fontFamily="?attr/hoppyDisplayFont"
            android:text="@string/app_name"
            android:textColor="?attr/colorOnSurface"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/aboutVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorOnSurface"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/about_author"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/aboutLink"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/about_repo_url"
            android:textAllCaps="false"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/aboutCheck"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/check_updates"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aboutStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center_horizontal"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/aboutLicenses"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/about_licenses"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
