<?xml version="1.0" encoding="utf-8"?>
<!--
  Hoppy themes (docs/design/themes.md). Each style is listed in HoppyTheme.kt; the
  `hoppyThemeKind` value must match the enum ordinal. Drawing code (backgrounds,
  mascot stage, buttons) reads the palette from res/values/colors.xml per theme.
-->
<resources>
    <!-- A · Purikura: photo-sticker booth, pastel and cute (default). -->
    <style name="Theme.Hoppy.Purikura" parent="Theme.Material3.Light.NoActionBar">
        <item name="hoppyThemeKind">purikura</item>
        <item name="hoppyMascot">@drawable/mascot_kawaii</item>
        <item name="hoppyDisplayFont">@font/mochiy_pop_one</item>
        <item name="hoppyBodyBoldFont">@font/zen_maru_gothic_black</item>
        <item name="android:fontFamily">@font/zen_maru_gothic_medium</item>
        <item name="fontFamily">@font/zen_maru_gothic_medium</item>
        <item name="hoppyInk">@color/purikura_primary_dark</item>
        <item name="hoppyCorner">24dp</item>
        <item name="hoppyFrameStroke">3dp</item>
        <item name="hoppyFrameStrokeColor">@color/white</item>
        <item name="hoppyCardShadow">0dp</item>
        <item name="hoppyCardBackground">@drawable/card_purikura</item>
        <item name="hoppyReceiveCardBackground">@drawable/card_purikura_receive</item>
        <item name="android:colorBackground">@color/purikura_bg</item>
        <item name="colorSurface">@color/purikura_bg</item>
        <item name="colorSurfaceContainerLowest">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/purikura_check_b</item>
        <item name="colorSurfaceContainer">@color/purikura_container</item>
        <item name="colorSurfaceContainerHigh">@color/purikura_check_b</item>
        <item name="colorSurfaceContainerHighest">@color/purikura_container</item>
        <item name="colorPrimary">@color/purikura_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/purikura_container</item>
        <item name="colorOnPrimaryContainer">@color/purikura_text</item>
        <item name="colorSecondary">@color/purikura_lavender</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/purikura_yellow</item>
        <item name="colorOnSurface">@color/purikura_text</item>
        <item name="colorOnBackground">@color/purikura_text</item>
        <item name="colorOnSurfaceVariant">@color/purikura_muted</item>
        <item name="colorOutline">@color/purikura_ring</item>
        <item name="colorOutlineVariant">@color/purikura_ring</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.Hoppy.Purikura</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.Hoppy.Purikura</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/Shape.Hoppy.Purikura</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

