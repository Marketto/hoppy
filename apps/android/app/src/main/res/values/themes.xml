    <!-- Old names (Kawaii / Pro) kept as aliases so stale references keep working. -->
    <style name="Theme.Hoppy.Kawaii" parent="Theme.Hoppy.Purikura" />
    <style name="Theme.Hoppy.Pro" parent="Theme.Hoppy.Night" />

    <style name="Shape.Hoppy.Purikura" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="Shape.Hoppy.Sharp" parent="">
