<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Installed as /usr/share/polkit-1/actions/app.hoppy.update.policy by the hoppy .deb. -->
<policyconfig>
  <vendor>Hoppy</vendor>
  <action id="app.hoppy.update">
    <description>Update Hoppy</description>
    <description xml:lang="it">Aggiorna Hoppy</description>
    <message>Authentication is required to install the new version of Hoppy</message>
    <message xml:lang="it">Per installare la nuova versione di Hoppy serve la password di un amministratore</message>
    <icon_name>hoppy</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/hoppy/install-update</annotate>
  </action>
</policyconfig>
