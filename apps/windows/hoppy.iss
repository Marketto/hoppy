; Hoppy installer for Windows (Inno Setup 6). Built by .github/workflows/release.yml:
;   iscc /DAppVersion=1.2.3 /DSourceExe=path\to\hoppy.exe /DSourceGuiExe=path\to\hoppyw.exe apps\windows\hoppy.iss
; hoppy.exe = CLI (console); hoppyw.exe = tray receiver + "Send to" GUI (no console).
; Per-user install, no admin rights: %LOCALAPPDATA%\Programs\Hoppy.

#ifndef AppVersion
  #define AppVersion "0.0.0-dev"
#endif
#ifndef SourceExe
  #define SourceExe "..\..\target\release\hoppy.exe"
#endif
#ifndef SourceGuiExe
  #define SourceGuiExe "..\..\target\release\hoppyw.exe"
#endif

[Setup]
AppId={{6F3C2B1A-8D4E-4B7A-9C55-48F0A1D3E7B2}
AppName=Hoppy
AppVersion={#AppVersion}
AppPublisher=Marco Ricupero
AppPublisherURL=https://github.com/Marketto/hoppy
AppSupportURL=https://github.com/Marketto/hoppy/issues
DefaultDirName={localappdata}\Programs\Hoppy
DisableDirPage=yes
DisableProgramGroupPage=yes
DefaultGroupName=Hoppy
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
OutputDir=..\..\dist
OutputBaseFilename=Hoppy-Setup-x64
SetupIconFile=..\..\assets\brand\hoppy.ico
UninstallDisplayIcon={app}\hoppyw.exe
WizardStyle=modern
Compression=lzma2
SolidCompression=yes
CloseApplications=force
LicenseFile=..\..\LICENSE

[Languages]
Name: "it"; MessagesFile: "compiler:Languages\Italian.isl"
Name: "en"; MessagesFile: "compiler:Default.isl"

[CustomMessages]
it.StartNow=Avvia Hoppy adesso (pronto a ricevere)
en.StartNow=Start Hoppy now (ready to receive)
it.Music=Musica
en.Music=Music
it.Firewall=Consenti Hoppy nel firewall di Windows (reti private e aziendali, richiede la conferma di un amministratore)
en.Firewall=Allow Hoppy through Windows Firewall (private and work networks, needs administrator approval)
it.ClassicMenu=Mostra «Invia con Hoppy» direttamente nel menu del tasto destro (menu classico di Windows)
en.ClassicMenu=Show "Send with Hoppy" directly in the right-click menu (classic Windows menu)
it.DesktopIcon=Icona «Hoppy» sul desktop (trascinaci sopra i file da inviare)
en.DesktopIcon="Hoppy" icon on the desktop (drop files on it to send them)
it.DesktopComment=Trascina qui i file da inviare con Hoppy
en.DesktopComment=Drop files here to send them with Hoppy
it.RestartExplorer=Il menu del tasto destro classico compare dopo il riavvio di Esplora risorse (o al prossimo accesso a Windows).%n%nRiavviare Esplora risorse ora? Le finestre di Esplora file aperte verranno chiuse.
en.RestartExplorer=The classic right-click menu appears after File Explorer restarts (or at your next Windows sign-in).%n%nRestart File Explorer now? Open File Explorer windows will close.

[Tasks]
; All checked by default and not offered to tray updates (/UPDATE=1), which keep what the
; first install set up (the program paths never change).
; Firewall: see "Firewall rules" in [Code].
Name: "firewall"; Description: "{cm:Firewall}"; Check: not IsUpdate
; Windows 11 only (Windows 10 has the classic menu anyway): see "Classic context menu" in
; [Code]. Without it "Send with Hoppy" sits under "Show more options".
Name: "classicmenu"; Description: "{cm:ClassicMenu}"; Check: (not IsUpdate) and IsWindows11
; Desktop shortcut to `hoppyw send`: drop files on it, or double-click to pick them.
Name: "desktopicon"; Description: "{cm:DesktopIcon}"; Check: not IsUpdate

[Files]
Source: "{#SourceExe}"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#SourceGuiExe}"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\..\LICENSE"; DestDir: "{app}"; DestName: "LICENSE.txt"; Flags: ignoreversion
; Wizard music (generated by tools/gen_music.py), extracted to {tmp} only, see [Code].
Source: "..\..\assets\music\desktop_idle.wav"; Flags: dontcopy
Source: "..\..\assets\music\desktop_done.wav"; Flags: dontcopy

[Icons]
Name: "{userprograms}\Hoppy"; Filename: "{app}\hoppyw.exe"; Comment: "Hoppy"
Name: "{userdesktop}\Hoppy"; Filename: "{app}\hoppyw.exe"; Parameters: "send"; Comment: "{cm:DesktopComment}"; Tasks: desktopicon

[Run]
; Adds "Send to → Hoppy" and the right-click verb "Send with Hoppy" (both hoppyw send, the
; verb in HKCU\Software\Classes\*\shell\Hoppy) and the tray receiver at login (hoppyw), see
; crates/hoppy-cli/src/platform.rs. Runs on updates too, so the verb reaches old installs.
Filename: "{app}\hoppy.exe"; Parameters: "install"; Flags: runhidden waituntilterminated
Filename: "{app}\hoppyw.exe"; Description: "{cm:StartNow}"; Flags: postinstall nowait skipifsilent
; Update started by the tray (hoppyw runs Setup with /VERYSILENT ... /UPDATE=1 and exits, see
; crates/hoppy-cli/src/update.rs): bring the tray back when done. If setup fails or stops
; early, DeinitializeSetup (see [Code]) relaunches it instead.
Filename: "{app}\hoppyw.exe"; Flags: nowait runasoriginaluser; Check: IsUpdate

[UninstallRun]
; Running copies are stopped first by CurUninstallStepChanged (see [Code]). Also removes the
; right-click verb, and the classic-menu override only if Hoppy created it.
Filename: "{app}\hoppy.exe"; Parameters: "uninstall"; Flags: runhidden; RunOnceId: "RemoveShortcuts"

[Messages]
it.FinishedLabel=Hoppy è installato e riceve file in background: trovi la sua icona nell'area di notifica, vicino all'orologio. Per inviare: seleziona uno o più file in Esplora file, tasto destro → «Invia con Hoppy» (se non lo vedi: Mostra altre opzioni, oppure Maiusc+tasto destro). Puoi anche trascinare i file sull'icona Hoppy del desktop.
en.FinishedLabel=Hoppy is installed and receives files in the background: look for its icon in the notification area, near the clock. To send: select one or more files in File Explorer, right-click → "Send with Hoppy" (if you don't see it: Show more options, or Shift+right-click). You can also drop files on the Hoppy icon on the desktop.

[Code]
// True when the tray started this install as an update (/UPDATE=1, see [Run]).
function IsUpdate(): Boolean;
begin
  Result := ExpandConstant('{param:UPDATE|0}') = '1';
end;

// Set at ssPostInstall: the files are in place and [Run] relaunches the tray itself.
var
  InstallFinished: Boolean;

// ---- Firewall rules. hoppyw.exe adds/removes them with netsh when started elevated
// (crates/hoppy-cli/src/firewall.rs: inbound allow for hoppyw.exe and hoppy.exe, TCP 47471
// + UDP 47470, Private + Domain profiles). Done here rather than in [Run]/[UninstallRun] so
// that a declined UAC prompt is silent (ShellExec just returns False) and nothing is asked
// when it is not needed.

// Exit code of `hoppyw firewall --check`: 0 allowed, 1 no rules, 2 rules but not allowed,
// 3 unknown; -1 if it could not run.
function FirewallCheck(): Integer;
var
  ResultCode: Integer;
begin
  Result := -1;
  if Exec(ExpandConstant('{app}\hoppyw.exe'), 'firewall --check', '', SW_HIDE,
    ewWaitUntilTerminated, ResultCode) then
    Result := ResultCode;
end;

// Runs `hoppyw firewall <Params>` as administrator (UAC prompt). Params is a constant.
procedure RunFirewallElevated(Params: String);
var
  ErrorCode: Integer;
begin
  if not ShellExec('runas', ExpandConstant('{app}\hoppyw.exe'), Params, '', SW_HIDE,
    ewWaitUntilTerminated, ErrorCode) then
    Log('Firewall rules not changed (UAC declined or failed): ' + IntToStr(ErrorCode));
end;

// ---- Classic context menu (Windows 11). `hoppy classic-menu on` writes an empty per-user
// HKCU\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32 and
// remembers in HKCU\Software\Hoppy that Hoppy created it (uninstall removes it only then).
// Explorer reads it at start: offer to restart Explorer, only if the menu really changes.
const
  ClassicMenuKey = 'Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32';

function IsWindows11(): Boolean;
var
  Version: TWindowsVersion;
begin
  GetWindowsVersionEx(Version);
  Result := Version.Build >= 22000;
end;

procedure EnableClassicMenu();
var
  WasOn: Boolean;
  ResultCode: Integer;
begin
  WasOn := RegKeyExists(HKCU, ClassicMenuKey);
  if not Exec(ExpandConstant('{app}\hoppy.exe'), 'classic-menu on', '', SW_HIDE,
    ewWaitUntilTerminated, ResultCode) or (ResultCode <> 0) then
  begin
    Log('Classic context menu not set: ' + IntToStr(ResultCode));
    Exit;
  end;
  // Silent installs default to No: never close Explorer windows unasked.
  if not WasOn and (SuppressibleMsgBox(CustomMessage('RestartExplorer'), mbConfirmation,
    MB_YESNO, IDNO) = IDYES) then
    Exec(ExpandConstant('{app}\hoppy.exe'), 'classic-menu --restart-explorer', '', SW_HIDE,
      ewWaitUntilTerminated, ResultCode);
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
  begin
    InstallFinished := True;
    if WizardIsTaskSelected('firewall') and (FirewallCheck() <> 0) then
      RunFirewallElevated('firewall --apply');
    if WizardIsTaskSelected('classicmenu') then
      EnableClassicMenu();
  end;
end;

// Update that failed or was aborted: the tray had already exited, bring back the copy
// that is still installed (an extra launch is harmless, hoppyw is single-instance).
procedure RelaunchTrayAfterFailedUpdate();
var
  Exe: String;
  ResultCode: Integer;
begin
  if not IsUpdate() or InstallFinished then
    Exit;
  try
    // {app} raises if Setup stopped before it was set: then there is nothing to relaunch.
    Exe := ExpandConstant('{app}\hoppyw.exe');
    if FileExists(Exe) then
      ExecAsOriginalUser(Exe, '', ExpandConstant('{app}'), SW_SHOWNORMAL, ewNoWait, ResultCode);
  except
  end;
end;

// Stops hoppy.exe / hoppyw.exe, but only the copies running from this install folder (an
// unrelated "hoppy.exe" elsewhere is left alone). Upgrades from 0.1.0 run `hoppy.exe
// receive` in a console, which CloseApplications cannot close, nor the tray app.
// The folder goes to PowerShell as a single-quoted literal (quotes doubled) and is
// compared with StartsWith, not -like, so '[' ']' in the path are not wildcards.
function PsQuote(S: String): String;
begin
  StringChangeEx(S, '''', '''''', True);
  Result := '''' + S + '''';
end;

procedure StopHoppy();
var
  Script: String;
  ResultCode: Integer;
begin
  Script :=
    '$d = ' + PsQuote(AddBackslash(ExpandConstant('{app}'))) + '; ' +
    '$p = @(Get-Process -Name hoppy,hoppyw -ErrorAction SilentlyContinue | ' +
    'Where-Object { $_.Path -and $_.Path.StartsWith($d, [StringComparison]::OrdinalIgnoreCase) }); ' +
    '$p | Stop-Process -Force -ErrorAction SilentlyContinue; ' +
    '$p | Wait-Process -Timeout 5 -ErrorAction SilentlyContinue';
  Exec(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'),
    '-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "' + Script + '"',
    '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  StopHoppy();
  Result := '';
end;

// usUninstall comes after the user confirms and before [UninstallRun] / file removal.
// Firewall: only asks for administrator approval when rules for this folder exist
// (check codes 0 and 2); best effort, declining leaves them behind (harmless: they name
// programs that no longer exist).
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  CheckCode: Integer;
begin
  if CurUninstallStep = usUninstall then
  begin
    StopHoppy();
    CheckCode := FirewallCheck();
    if (CheckCode = 0) or (CheckCode = 2) then
      RunFirewallElevated('firewall --remove');
  end;
end;

// ---- Wizard music: idle loop while the wizard is open, jingle on the finished page.
// Never in silent installs; "♪ Music" checkbox bottom-left mutes it.
const
  SND_ASYNC = $0001;
  SND_NODEFAULT = $0002;
  SND_LOOP = $0008;
  SND_FILENAME = $00020000;

// Same winmm function twice: with a file name, and with NULL (= stop playback).
// DLL name in capitals, or the tools/dev.py secrets scan mistakes it for an e-mail.
function PlaySoundFile(Sound: String; Module: Longint; Flags: Cardinal): Integer;
  external 'PlaySoundW@WINMM.DLL stdcall';
function PlaySoundStop(Sound: Longint; Module: Longint; Flags: Cardinal): Integer;
  external 'PlaySoundW@WINMM.DLL stdcall';

var
  MusicReady: Boolean;
  MusicBox: TNewCheckBox;
  IdleWav: String;
  DoneWav: String;

procedure StopMusic();
begin
  PlaySoundStop(0, 0, 0);
end;

procedure PlayIdle();
begin
  if MusicReady and MusicBox.Checked then
    PlaySoundFile(IdleWav, 0, SND_FILENAME or SND_ASYNC or SND_LOOP or SND_NODEFAULT);
end;

procedure MusicBoxClick(Sender: TObject);
begin
  if not MusicBox.Checked then
    StopMusic()
  else if WizardForm.CurPageID <> wpFinished then
    PlayIdle();
end;

procedure InitializeWizard();
begin
  if WizardSilent() then
    Exit;
  ExtractTemporaryFile('desktop_idle.wav');
  ExtractTemporaryFile('desktop_done.wav');
  IdleWav := ExpandConstant('{tmp}\desktop_idle.wav');
  DoneWav := ExpandConstant('{tmp}\desktop_done.wav');

  MusicBox := TNewCheckBox.Create(WizardForm);
  MusicBox.Parent := WizardForm;
  MusicBox.Caption := #$266A + ' ' + CustomMessage('Music');
  MusicBox.Checked := True;
  MusicBox.Left := ScaleX(16);
  MusicBox.Width := ScaleX(140);
  MusicBox.Height := ScaleY(17);
  MusicBox.Top := WizardForm.CancelButton.Top +
    (WizardForm.CancelButton.Height - MusicBox.Height) div 2;
  MusicBox.Anchors := [akLeft, akBottom];
  MusicBox.OnClick := @MusicBoxClick;

  MusicReady := True;
  PlayIdle();
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  if MusicReady and (CurPageID = wpFinished) then
  begin
    StopMusic();
    if MusicBox.Checked then
      PlaySoundFile(DoneWav, 0, SND_FILENAME or SND_ASYNC or SND_NODEFAULT);
  end;
end;

// Stop before Setup deletes {tmp}.
procedure DeinitializeSetup();
begin
  if MusicReady then
    StopMusic();
  RelaunchTrayAfterFailedUpdate();
end;
